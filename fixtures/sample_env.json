      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [{
          "Effect": "Allow",
          "Action": ["s3:GetObject"],
          "Resource": ["arn:aws:s3:::private-archive/*"]
        }]
      }
    }
  ],
  "security_groups": [
    {
      "GroupId": "sg-001",
      "GroupName": "public-ssh",
